+    tmp = data_buf[M1_PROTO_CURRENT_WEIGHT_POS : M1_PROTO_CURRENT_WEIGHT_POS + 4]
+    info['CURRENT_WEIGHT'] = (tmp[3] << 24) | (tmp[2] << 16) | (tmp[1] << 8) | tmp[0]
