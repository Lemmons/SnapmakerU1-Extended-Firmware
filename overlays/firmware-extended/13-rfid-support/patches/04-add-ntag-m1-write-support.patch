+    # Reader-A: M1, write specific sector data
+    def __reader_a_m1_write_sector_data(self, sector:int, block_offset:int, data:list, uid:list, auth_mode:int, auth_key:list, retry_times=3) -> int:
+        if len(data) != 16:
+            logging.error("M1 block write requires exactly 16 bytes, got %d", len(data))
+            return FM175XX_CARD_WRITE_ERR
+
+        if block_offset >= 3:  # Block 3 is the sector trailer, don't write to it
+            logging.error("M1 block offset must be 0-2, got %d", block_offset)
+            return FM175XX_CARD_WRITE_ERR
+
+        # Authenticate to the sector
+        for retry in range(retry_times):
+            ret = self.__reader_a_mifare_auth(auth_mode, sector, auth_key[sector], uid)
+            if ret == FM175XX_OK:
+                break
+
+        if ret != FM175XX_OK:
+            logging.error("M1 sector %d authentication failed after %d retries", sector, retry_times)
+            return FM175XX_CARD_AUTH_ERR
 
+        # Calculate block number
+        block_num = sector * 4 + block_offset
+
+        # Write the block
+        for retry in range(retry_times):
+            ret = self.__reader_a_m1_block_write(block_num, data)
+            if ret == FM175XX_OK:
+                break
+
+        if ret != FM175XX_OK:
+            logging.error("M1 block %d write failed after %d retries", block_num, retry_times)
+            return FM175XX_CARD_WRITE_ERR
+
+        # Verify by reading back
+        read_result = self.__reader_a_m1_block_read(block_num)
+        if read_result.err_code != FM175XX_OK:
+            logging.error("M1 block %d read-back verification failed", block_num)
+            return FM175XX_CARD_WRITE_ERR
+
+        # Compare written data with read data
+        if read_result.out_param != data:
+            logging.error("M1 block %d write verification mismatch", block_num)
+            return FM175XX_CARD_WRITE_ERR
+
+        return FM175XX_OK
+
